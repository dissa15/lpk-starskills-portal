# Salin menjadi .env (JANGAN commit .env). Isi nilai yang diperlukan.

# --- Gemini (wajib untuk menjawab dengan RAG) ---
GEMINI_API_KEY=
# Isi dengan nama model Flash yang tersedia untuk akunmu di Google AI Studio (nama model sering berubah)
GEMINI_MODEL=

# --- Opsional (nilai bawaan sudah terpasang di sika/config.py) ---
SIKA_RETRIEVER=bm25              # bm25, dense, atau hybrid (pilih dari hasil notebook retrieval)
SIKA_MIN_SCORE_BM25=1.5
SIKA_MIN_SCORE_DENSE=0.35        # asumsi awal, kalibrasi dengan notebook retrieval bagian 7
SIKA_CONF_THRESHOLD=0.25
SIKA_LLM_TIMEOUT_S=10
SIKA_WHATSAPP_NUMBER=6281907035915
SIKA_QUIZ_URL=/rekomendasi-jurusan
